// tests/loop_control_test.orion

// Test break in a for loop
var sum_break_for = 0;
for (var i = 0; i < 10; i = i + 1) {
  if (i == 5) {
    break;
  }
  sum_break_for = sum_break_for + i;
}
print(sum_break_for); // Expected output: 10 (0+1+2+3+4)

// Test continue in a for loop
var sum_continue_for = 0;
for (var j = 0; j < 5; j = j + 1) {
  if (j == 2) {
    continue;
  }
  sum_continue_for = sum_continue_for + j;
}
print(sum_continue_for); // Expected output: 7 (0+1+3+4)

// Test break in a while loop
var k = 0;
var sum_break_while = 0;
while (k < 10) {
  if (k == 5) {
    break;
  }
  sum_break_while = sum_break_while + k;
  k = k + 1;
}
print(sum_break_while); // Expected output: 10 (0+1+2+3+4)

// Test continue in a while loop
var l = 0;
var sum_continue_while = 0;
while (l < 5) {
  if (l == 2) {
    l = l + 1;
    continue;
  }
  sum_continue_while = sum_continue_while + l;
  l = l + 1;
}
print(sum_continue_while); // Expected output: 7 (0+1+3+4)
