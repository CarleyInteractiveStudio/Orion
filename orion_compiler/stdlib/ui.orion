// Orion Standard UI Library
// Version 0.3
module ui;
use draw;
use str;

// A simple text label component.
component Label {
    x: 0;
    y: 0;
    text: "Label";
    color: "#000000";
    fontSize: 16;

    render() {
        draw.text({
            x: this.x,
            y: this.y,
            text: this.text,
            color: this.color,
            fontSize: this.fontSize
        });
    }
}

// Layout components. These are special and handled by the layout engine.
component Column {
    children: [];
    spacing: 0;
    padding: 0;
    align: "start";
}
component Row {
    children: [];
    spacing: 0;
    padding: 0;
    align: "start";
}

// A stateful checkbox component.
component Checkbox {
    x: 0;
    y: 0;
    size: 20;
    width: 20;
    height: 20;
    label: "";
    onChange: nil;

    state: { "is_checked": false };

    onClick() {
        this.state["is_checked"] = !(this.state["is_checked"]);
        if (!(this.onChange == nil)) {
            var callback = this.onChange;
            callback(this.state["is_checked"]);
        }
    }

    render() {
        draw.box({ x: this.x, y: this.y, width: this.size, height: this.size, color: "#AAAAAA" });
        if (this.state["is_checked"]) {
            draw.box({ x: this.x + 4, y: this.y + 4, width: this.size - 8, height: this.size - 8, color: "#3498DB" });
        }
        if (!(this.label == "")) {
            draw.text({ x: this.x + this.size + 10, y: this.y + (this.size / 2) + 6, text: this.label, color: "#000000", fontSize: 16 });
        }
    }
}

// A simple button component.
component Button {
    x: 0;
    y: 0;
    width: 100;
    height: 40;
    text: "Button";
    color: "#DDDDDD";
    hover_color: "#EEEEEE";
    onClick: nil;

    state: { "is_hovering": false };

    onMouseEnter() {
        this.state["is_hovering"] = true;
    }

    onMouseLeave() {
        this.state["is_hovering"] = false;
    }

    render() {
        var current_color = this.color;
        if (this.state["is_hovering"]) {
            current_color = this.hover_color;
        }
        draw.box({ x: this.x, y: this.y, width: this.width, height: this.height, color: current_color });
        var text_width = draw.measure_text(this.text, 16);
        var text_x = this.x + (this.width - text_width) / 2;
        var text_y = this.y + (this.height / 2) + 6;
        draw.text({ x: text_x, y: text_y, text: this.text, color: "#000000", fontSize: 16 });
    }
}

// A scrollable view for containing content that is larger than the view area.
component ScrollView {
    x: 0;
    y: 0;
    width: 200;
    height: 200;
    children: [];

    state: {
        "scroll_y": 0.0,
        "content_height": 0.0 // Will be calculated by the layout engine
    };

    onMouseWheel(event) {
        // scroll speed
        var scroll_speed = 20;
        var new_scroll_y = this.state["scroll_y"] + (event.y * scroll_speed);

        // Clamping
        var max_scroll = this.state["content_height"] - this.height;
        if (max_scroll < 0) { max_scroll = 0; }
        if (new_scroll_y < 0) { new_scroll_y = 0; }
        if (new_scroll_y > max_scroll) { new_scroll_y = max_scroll; }

        this.state["scroll_y"] = new_scroll_y;
    }

    render() {
        // The ScrollView itself doesn't draw anything, it just provides a clipping
        // area and returns its children to be rendered by the layout engine.
        return this.children;
    }
}

// A text input component.
component TextInput {
    x: 0;
    y: 0;
    width: 200;
    height: 30;

    // Style properties
    bgColor: "#EEEEEE";
    fgColor: "#000000";
    borderColor: "#CCCCCC";
    focusColor: "#007AFF"; // A nice blue for focus indication

    // Internal state
    state: {
        "text": "",
        "is_focused": false,
        "cursor_pos": 0,
        "cursor_blink_on": true,
        "last_blink_time": 0.0
    };

    onKeyDown(event) {
        if (!this.state["is_focused"]) {
            return;
        }

        var key = event.key;
        if (key == "backspace") {
            if (this.state["cursor_pos"] > 0) {
                var current_text = this.state["text"];
                var pos = this.state["cursor_pos"];
                this.state["text"] = slice(current_text, 0, pos - 1) + slice(current_text, pos);
                this.state["cursor_pos"] = pos - 1;
            }
        } else if (key == "left") {
            if (this.state["cursor_pos"] > 0) {
                this.state["cursor_pos"] = this.state["cursor_pos"] - 1;
            }
        } else if (key == "right") {
            if (this.state["cursor_pos"] < str.length(this.state["text"])) {
                this.state["cursor_pos"] = this.state["cursor_pos"] + 1;
            }
        }
    }

    onTextInput(event) {
        if (!this.state["is_focused"]) {
            return;
        }
        var current_text = this.state["text"];
        var pos = this.state["cursor_pos"];
        this.state["text"] = slice(current_text, 0, pos) + event.text + slice(current_text, pos);
        this.state["cursor_pos"] = pos + str.length(event.text);
    }

    onClick(event) {
        // Basic focus handling: if clicked inside, gain focus.
        // A more robust implementation would require a global focus manager.
        this.state["is_focused"] = true;
    }

    render() {
        // Update cursor blink state
        var current_time = clock();
        if ((current_time - this.state["last_blink_time"]) > 0.5) {
            this.state["cursor_blink_on"] = !this.state["cursor_blink_on"];
            this.state["last_blink_time"] = current_time;
        }

        // Draw the border
        var border_color = this.borderColor;
        if (this.state["is_focused"]) {
            border_color = this.focusColor;
        }
        draw.box({
            x: this.x, y: this.y, width: this.width, height: this.height,
            color: border_color
        });

        // Draw the background
        draw.box({
            x: this.x + 1, y: this.y + 1, width: this.width - 2, height: this.height - 2,
            color: this.bgColor
        });

        // Draw the text
        draw.text({
            x: this.x + 5, y: this.y + (this.height / 2) + 7,
            text: this.state["text"],
            color: this.fgColor,
            fontSize: 16
        });

        // Draw the cursor
        if (this.state["is_focused"]) {
            if (this.state["cursor_blink_on"]) {
                var text_up_to_cursor = slice(this.state["text"], 0, this.state["cursor_pos"]);
                var cursor_x_offset = draw.measure_text(text_up_to_cursor, 16);
                draw.box({
                    x: this.x + 5 + cursor_x_offset, y: this.y + 5,
                    width: 1, height: this.height - 10,
                    color: this.fgColor
                });
            }
        }
    }
}

component Slider {
    // --- Properties ---
    x: 0;
    y: 0;
    width: 200;
    height: 20;
    min: 0;
    max: 100;
    value: 50;
    onChange: nil;

    // --- State ---
    state: {
        is_dragging: false
    };

    // --- Methods ---
    onMouseDown(event) {
        this.state.is_dragging = true;
    }

    onMouseUp(event) {
        this.state.is_dragging = false;
    }

    onMouseMove(event) {
        if (this.state.is_dragging) {
            // Calculate the new value based on mouse position
            var raw_value = ((event.x - this.x) / this.width) * (this.max - this.min) + this.min;

            // Clamp the value to be within min and max
            if (raw_value < this.min) {
                raw_value = this.min;
            }
            if (raw_value > this.max) {
                raw_value = this.max;
            }
            this.value = raw_value;

            // Call the onChange callback if it exists
            if (this.onChange != nil) {
                this.onChange(this.value);
            }
        }
    }

    render() {
        // --- Draw the track ---
        var track_height = 4;
        var track_y = this.y + (this.height / 2) - (track_height / 2);
        draw.box({
            x: this.x,
            y: track_y,
            width: this.width,
            height: track_height,
            color: "#CCCCCC"
        });

        // --- Draw the thumb ---
        var thumb_width = 10;
        var thumb_height = this.height;
        var value_percent = (this.value - this.min) / (this.max - this.min);
        var thumb_x = this.x + (value_percent * (this.width - thumb_width));

        draw.box({
            x: thumb_x,
            y: this.y,
            width: thumb_width,
            height: thumb_height,
            color: "#888888"
        });
    }
}
